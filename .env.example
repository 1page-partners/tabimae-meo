VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Netlifyの Site configuration > Environment variables にも同じ値を登録してください。
# Google OAuth は Supabase Edge Functions の Secrets で設定します。
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI / APP_URL
# GOOGLE_CLIENT_SECRET を VITE_ 変数に設定しないでください。

# ローカル開発専用。Googleには接続せずGBP応答を模擬します。
# VITE_GBP_MOCK=true
